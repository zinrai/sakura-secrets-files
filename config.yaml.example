vault:
  id: "123456789012"  # Your secret vault resource ID
  zone: is1a          # Optional: SAKURA Cloud zone (default: is1a)

# dest is always relative to -base-dir
secrets:
  - name: production-db-password
    dest: database/db_password

  - name: production-api-key
    dest: application/api_key

  - name: production-tls-cert
    dest: webserver/server.crt

  - name: production-tls-key
    dest: webserver/server.key
